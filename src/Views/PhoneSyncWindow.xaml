<Window x:Class="ClipShelf.Views.PhoneSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipShelf.ViewModels"
        Title="Phone Sync"
        Height="640"
        Width="720"
        ResizeMode="CanResize"
        MinHeight="520"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📱 Phone Sync" FontSize="22" FontWeight="Bold" Foreground="#2E75B6" Margin="0,0,0,12"/>

        <!-- Status + QR row -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="16" Margin="0,0,0,12" Background="#F9F9F9" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Status:" Width="100" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#2E75B6" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Local IP:" Width="100" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LocalIp}" Foreground="#333"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="PIN:" Width="100" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Pin}" Foreground="#333" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bluetooth:" Width="100" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BluetoothStatus}" Foreground="#333"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Regenerate PIN" Command="{Binding RegeneratePinCommand}" Padding="10,6" Margin="0,0,8,0" Background="#2E75B6" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="Share files" Command="{Binding ShareFilesCommand}" Padding="10,6" Margin="0,0,8,0" Background="#5A9BD5" Foreground="White" FontWeight="SemiBold" ToolTip="Select files on this PC to make available for download on the phone."/>
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="10,6" Margin="0,0,8,0" Background="#5A9BD5" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="Allow in Firewall" Command="{Binding AllowFirewallCommand}" Padding="10,6" Background="#C75050" Foreground="White" FontWeight="SemiBold" ToolTip="If phone can&#39;t connect, run this then open Command Prompt as Admin and paste"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="8" Background="White" Margin="16,0,0,0">
                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>

        <!-- Scan hint -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Scan QR with your phone — open the link, enter PIN, then drag-and-drop or select files to upload (max 100MB)." 
                       TextWrapping="Wrap" Foreground="#666" FontSize="12"/>
            <TextBlock Text="If your phone says &quot;can't be reached&quot; or &quot;timed out&quot;, click Allow in Firewall above, then run the copied command in Command Prompt (Run as administrator)." 
                       TextWrapping="Wrap" Foreground="#C75050" FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Received files -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Padding="10" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Received files" FontWeight="Bold" Margin="0,0,0,8"/>
                <ListView ItemsSource="{Binding ReceivedFiles}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#EEE" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="Gray">
                                            <Run Text="{Binding ReceivedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Source}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Button Grid.Row="4" Content="Close" Click="CloseButton_Click" Margin="0,16,0,0" Padding="14,8" HorizontalAlignment="Right" Background="#2E75B6" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>
