<Window
    x:Class="ClipShelf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClipShelf"
    xmlns:vm="clr-namespace:ClipShelf.ViewModels"
    Title="ClipShelf"
    Height="550"
    Width="900">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <StackPanel>
        <!-- Clock Icon header -->
        <TextBlock 
            Text="🕐 ClipShelf" 
            FontSize="24" 
            FontWeight="Bold" 
            Foreground="#2E75B6" 
            TextAlignment="Center" 
            Padding="10"/>

        <Separator/>

        <!-- Buttons Row -->
        <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Height="35">
            <TextBox
                Width="300"
                Height="35"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                Padding="8"
                FontSize="12"
                VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button
                Margin="10,0,0,0"
                Content="Search PC"
                Command="{Binding SearchCommand}"
                Padding="8,5"
                Background="#7CBB00"
                Foreground="White"
                FontWeight="Bold" />
            
            <Button
                Margin="10,0,0,0"
                Content="Clear History"
                Command="{Binding ClearHistoryCommand}"
                Padding="8,5"
                Background="#2E75B6"
                Foreground="White"
                FontWeight="Bold" />
            <Button
                Margin="10,0,0,0"
                Content="📱 Phone Sync"
                Command="{Binding OpenPhoneSyncCommand}"
                Padding="8,5"
                Background="#5A9BD5"
                Foreground="White"
                FontWeight="Bold" />
            <Button
                Margin="10,0,0,0"
                Content="⏱ Shutdown"
                Command="{Binding OpenShutdownTimerCommand}"
                Padding="8,5"
                Background="#C75050"
                Foreground="White"
                FontWeight="Bold" />
        </StackPanel>

        <Separator/>

        <!-- Clipboard history list -->
        <ListView
            ItemsSource="{Binding ClipboardHistory}"
            Margin="10,10,10,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" BorderThickness="0,0,0,1" BorderBrush="LightGray">
                        <StackPanel>
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Content" Value="{Binding Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Image">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Image Source="{Binding Image}"
                                                               MaxHeight="200"
                                                               Stretch="Uniform" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <TextBlock 
                                Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                FontSize="10"
                                Foreground="Gray" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Window>